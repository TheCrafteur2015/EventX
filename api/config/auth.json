{
  "token": [
    {
      "type": "var",
      "_GET": [
        "access_token",
        "private_token"
      ]
    },
    {
      "type": "func",
      "getallheaders": [
        "PRIVATE-TOKEN",
        "X-Auth-Token",
        "Authorization"
      ]
    }
  ],
  "user": [
    {
      "type": "func",
      "getallheaders": [
        "Authorization"
      ]
    }
  ]
}